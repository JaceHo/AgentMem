<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>ai.agent.memory</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>/Users/jace/code/agentmem/agentmem.sh</string>
    <string>start-fg</string>
  </array>

  <key>WorkingDirectory</key>
  <string>/Users/jace/code/agentmem</string>

  <key>RunAtLoad</key>
  <true/>

  <key>KeepAlive</key>
  <true/>

  <!-- 5s throttle: enough time for port release after crash/kill -->
  <key>ThrottleInterval</key>
  <integer>5</integer>

  <key>StandardOutPath</key>
  <string>/Users/jace/.agentmem/logs/stdout.log</string>

  <key>StandardErrorPath</key>
  <string>/Users/jace/.agentmem/logs/stderr.log</string>

  <key>EnvironmentVariables</key>
  <dict>
    <!-- Prevent tokenizer parallelism → eliminates semaphore leak on shutdown -->
    <key>TOKENIZERS_PARALLELISM</key>
    <string>false</string>
    <!-- Single-threaded OMP → no multiprocessing semaphores to leak -->
    <key>OMP_NUM_THREADS</key>
    <string>1</string>
    <key>MKL_NUM_THREADS</key>
    <string>1</string>
    <!-- Offline model loading (no HuggingFace network calls) -->
    <key>HF_HUB_OFFLINE</key>
    <string>1</string>
    <key>TRANSFORMERS_OFFLINE</key>
    <string>1</string>
    <!-- PATH: launchd does not inherit user PATH; include homebrew so uv is found -->
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
    <!-- uv: reuse existing venv/ instead of creating .venv — avoids re-install on kickstart -->
    <key>UV_PROJECT_ENVIRONMENT</key>
    <string>/Users/jace/code/agentmem/venv</string>
    <!-- Embedding width is MEASURED at boot (core/embedder.py `_measure_provider`),
         never taken from a declared value: names below are hints for the loader, and
         core/dim_guard.py fails the boot if the measured width disagrees with any
         vectorset. This block used to say openai/nomic/768 while the live sets were
         built at 1024, which made every write fail under a 200 {"status":"queued"}.
         Keep this file equal to ~/Library/LaunchAgents/ai.agent.memory.plist — a
         restore from git must not resurrect a width the index cannot hold. -->
    <key>EMBEDDING_PROVIDER</key>
    <string>local</string>
    <key>EMBEDDING_MODEL</key>
    <string>/Users/jace/.cache/models/qwen3-embedding-0.6b</string>
    <key>EMBEDDING_DIMS</key>
    <string>1024</string>
    <key>EMBEDDING_DEVICE</key>
    <string>mps</string>
    <key>EMBEDDING_BATCH</key>
    <string>8</string>
    <key>OPENAI_API_KEY</key>
    <string>sk-aiserv-local-dev</string>
    <key>OPENAI_BASE_URL</key>
    <string>http://localhost:4000/v1</string>
    <key>OPENAI_EMBED_MODEL</key>
    <string>nomic-embed-text</string>
    <!-- NOTE: ZAI_API_KEY and ZAI_PROXY are intentionally NOT set here.
         They are read fresh from .env on every extraction call,
         enabling zero-downtime key rotation without launchctl reload. -->
    <!-- A-MAC admission threshold: 0.15 for normal operation.
         Dev conversations score 0.10-0.20 (typ=0.00, HIGH_VALUE_RE rarely fires).
         0.05 was used for initial bulk re-digest; 0.15 filters pure noise. -->
    <key>AGENTMEM_AMAC_THRESHOLD</key>
    <string>0.15</string>
  </dict>
</dict>
</plist>
