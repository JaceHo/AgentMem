# AgentMem — LAN defaults (trusted network, no cloud keys, no auth)
# Copy to `.env` and adjust. Everything below is optional on a local LAN
# with aiserv running at http://127.0.0.1:4000.

# ── Auth (OFF by default) ───────────────────────────────────────────
# Leave unset on trusted LAN. Enable only when exposing beyond LAN:
# AGENTMEM_AUTH=1
# AGENTMEM_API_KEY=generate-a-long-random-token

# ── Inference via local aiserv (no external / cloud API key) ─────────
AISERV_URL=http://127.0.0.1:4000
OPENAI_BASE_URL=http://127.0.0.1:4000/v1
OPENAI_API_KEY=sk-aiserv-local-dev
# EMBEDDING_PROVIDER=openai          # optional force; auto-detects aiserv
# OPENAI_EMBED_MODEL=nomic-embed-text

# ── Optional: ZAI direct path (only if bypassing aiserv) ────────────
# ZAI_API_KEY=your-key-here
# ZAI_PROXY=

# ── Redis ───────────────────────────────────────────────────────────
# REDIS_URL=redis://localhost:6379/0
